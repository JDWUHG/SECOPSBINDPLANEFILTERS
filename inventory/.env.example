# Copy to .env (git-ignored) and fill in. Do NOT commit real values.
BINDPLANE_URL=https://app.bindplane.com
BINDPLANE_API_KEY=bps_xxxxxxxxxxxxxxxxxxxxxxxx

# Multi-project instances: set to the target project/account id.
# Find it in the UI URL: app.bindplane.com/p/<THIS-ID>/...
# Google SecOps UK = 01KC4W80ECMCJ8QJ9AG85S9S5J
BINDPLANE_ACCOUNT_ID=01KC4W80ECMCJ8QJ9AG85S9S5J
